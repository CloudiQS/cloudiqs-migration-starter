# DMS validation context — participant copy
# Copy to engagements/<engagement>/configs/dms-validation-context.env and replace every
# placeholder. This file contains identifiers and secret ARNs only. Never put a
# database username, password, secret JSON, token, or connection string here.

AWS_REGION="<aws-region>"
DMS_TASK_ARN="<dms-replication-task-arn>"
SOURCE_ENDPOINT_ARN="<dms-source-endpoint-arn>"
TARGET_ENDPOINT_ARN="<dms-target-endpoint-arn>"

# The runner resolves each secret only in memory while it runs its aggregate
# queries. The secret JSON must expose a username/user field and a password field.
SOURCE_DB_HOST="<source-mysql-host>"
SOURCE_DB_PORT="3306"
SOURCE_DB_NAME="<source-database>"
SOURCE_DB_SECRET_ARN="<source-database-secret-arn>"
TARGET_DB_HOST="<target-mysql-host>"
TARGET_DB_PORT="3306"
TARGET_DB_NAME="<target-database>"
TARGET_DB_SECRET_ARN="<target-database-secret-arn>"

# Use the target application URL without credentials or query-string secrets.
TARGET_APP_BASE_URL="http://<app-private-host>:8080"

# The signed rollback owner and recovery objective are evidence inputs, not a
# command to stop, delete, restart, or otherwise modify any service. A lab may
# record simulation values only when the T12 register labels its decision as
# SIMULATION ONLY; those values never satisfy production approval.
ROLLBACK_OWNER="<named-owner-or-simulation-label>"
ROLLBACK_RTO="<approved-rto-or-simulation-label>"

# Optional: a pre-existing CloudWatch or console capture for the two CDC latency
# metrics. The runner records this path; it does not copy the file. A lab-only
# attestation must be labelled SIMULATION ONLY in the decision register.
CDC_EVIDENCE_PATH=""

# The generated Stage-1/Stage-3 aggregate query file. Relative paths resolve
# from the workshop root after this context has been copied to engagements/<engagement>/configs/.
VALIDATION_QUERY_FILE="scripts/validation-queries.sql"   # relative to the engagement folder
