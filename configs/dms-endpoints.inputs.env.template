# Copy to engagements/<engagement>/configs/dms-endpoints.inputs.env.
# Identifiers only. Never a username, password, token or connection string.
AWS_REGION="<region>"
TARGET_STACK_NAME="<engagement>-<environment>-target"
SOURCE_SSM_PREFIX="/cq/<engagement>/source/<database>"   # holds host, port, secret_arn
SOURCE_ENGINE="mysql"                                     # DMS engine name for the source
SOURCE_DB_NAME="<source-database>"
TARGET_DB_NAME=""                                         # empty = stack DbName output
DMS_SSL_MODE="require"                                    # none only in an isolated lab
ENDPOINT_PREFIX="<engagement>-<environment>"
DISABLE_TARGET_FK_CHECKS="true"
